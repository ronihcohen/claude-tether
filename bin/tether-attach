#!/bin/sh
# tether-attach: server side of claude-tether.
# Attaches to a persistent Claude Code session, or starts one. dtach only keeps
# the process alive and passes its output straight through, so the local
# terminal keeps native scrollback, selection and copy/paste.
#
# Usage: tether-attach [-d DIR] [NAME]
#        tether-attach -r ID [NAME]
#        tether-attach -l [-n COUNT]
#   NAME  session name (default: "default"); one dtach socket per name
#   -d    working directory for a new session (default: the session's last
#         directory, else $TETHER_DIR, else $HOME); ignored while it is running
#   -r    resume conversation ID: reattach to the tether session already in
#         it, else start session NAME (default: the ID's first 8 characters)
#         on it, in the conversation's own directory
#   -l    list Claude conversations on this machine, newest first: id, age,
#         project and title, marking the ones tether sessions are in
#   -n    how many to list (default 20; 0 lists all)
#
# Detach: Ctrl-\   Reattach: run it again.
#
# Environment (all optional):
#   TETHER_STATE_DIR      sockets and state (default ~/.local/state/claude-tether)
#   TETHER_DIR            default working directory
#   TETHER_RESTORE_MODES  1 (default) or 0: on reattach, re-enable the terminal
#                         modes Claude sets only at startup
#   TETHER_RUN            path to tether-run (default: next to this script)
#   NO_COLOR              disable colors
set -u

usage() { echo "usage: tether-attach [-d DIR] [NAME] | -r ID [NAME] | -l [-n COUNT]" >&2; exit 2; }
die() { echo "tether: $*" >&2; exit 1; }
dir="" list=0 count=20 resume=""
while getopts d:ln:r:h opt; do
  case $opt in d) dir=$OPTARG ;; l) list=1 ;; n) count=$OPTARG ;; r) resume=$OPTARG ;; *) usage ;; esac
done
shift $((OPTIND - 1))
case $count in "" | *[!0-9]*) echo "tether: -n wants a number: $count" >&2; exit 2 ;; esac

base=${TETHER_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/claude-tether}
mkdir -p "$base" && chmod 700 "$base"
cfg=${CLAUDE_CONFIG_DIR:-$HOME/.claude}
run=${TETHER_RUN:-$(cd "$(dirname "$0")" && pwd)/tether-run}

# the dtach master for a socket (default: this session's), if one is running
find_master() { pgrep -o -f "^dtach -A ${1:-$sock} " 2>/dev/null; }

# -r: pick the session for conversation $resume, and point it there
if [ -n "$resume" ]; then
  case $resume in *[!A-Za-z0-9-]*) echo "tether: invalid conversation id: $resume" >&2; exit 2 ;; esac
  conv=""
  for f in "$cfg"/projects/*/"$resume".jsonl; do [ -f "$f" ] && conv=$f && break; done
  [ -n "$conv" ] || die "no conversation $resume on $(hostname) (tether -l lists them)"
  in=""   # a running session already in it
  for s in "$base"/*.session; do
    [ -f "$s" ] || continue
    n=$(basename "$s" .session)
    [ "$(cat "$s" 2>/dev/null)" = "$resume" ] && [ -n "$(find_master "$base/$n.sock")" ] && in=$n && break
  done
  if [ -n "$in" ]; then
    set -- "$in"
  else
    name=${1:-$(printf %s "$resume" | cut -c1-8)}
    [ -z "$(find_master "$base/$name.sock")" ] ||
      die "session '$name' is running another conversation; quit Claude there first, or pick another name"
    # the directory Claude filed it under: the cwd whose dashed form is the folder
    folder=$(basename "$(dirname "$conv")")
    dir=$(grep -o '"cwd": *"[^"]*"' "$conv" | sed 's/^"cwd": *"//; s/"$//' | sort -u |
      while IFS= read -r c; do
        [ "$(printf %s "$c" | sed 's/[^A-Za-z0-9]/-/g')" = "$folder" ] && { printf %s "$c"; break; }
      done)
    if [ -z "$dir" ] || [ ! -d "$dir" ]; then die "can't find the directory of conversation $resume"; fi
    printf %s "$resume" >"$base/$name.session"
    printf %s "$dir" >"$base/$name.dir"
    set -- "$name"
  fi
  # the same conversation open in another Claude would fork it
  for f in "$cfg"/sessions/*.json; do
    if [ -f "$f" ] && grep -q "\"sessionId\": *\"$resume\"" "$f"; then
      p=$(basename "$f" .json)
      kill -0 "$p" 2>/dev/null && [ -z "$in" ] && echo "tether: note: conversation $resume is also open in Claude pid $p" >&2
    fi
  done
fi

name=${1:-default}
case $name in "" | *[!A-Za-z0-9._-]*) echo "tether: invalid session name: $name" >&2; exit 2 ;; esac
sock=$base/$name.sock
state=$base/$name.session
dirfile=$base/$name.dir

# -l: Claude's conversations, newest first. The title is the one set with
# /rename, else Claude's own, else the last prompt.
if [ $list = 1 ]; then
  command -v python3 >/dev/null 2>&1 || { echo "tether: -l needs python3 on $(hostname)" >&2; exit 1; }
  # "name id running" for each tether session that has a conversation
  tags=$(for s in "$base"/*.session; do
    [ -f "$s" ] || continue
    n=$(basename "$s" .session) id=$(cat "$s" 2>/dev/null)
    [ -n "$id" ] || continue
    up=0; [ -n "$(find_master "$base/$n.sock")" ] && up=1
    echo "$n $id $up"
  done)
  NO_COLOR=${NO_COLOR:-$([ -t 1 ] || echo 1)} \
    exec python3 - "$cfg/projects" "$count" "$HOME" "$tags" <<'PY'
import glob, json, os, re, shutil, sys, time
root, count, home, tags = sys.argv[1], int(sys.argv[2]), sys.argv[3], sys.argv[4]
color = not os.environ.get("NO_COLOR")
dim, acc, ok, off = ("\033[2m", "\033[36m", "\033[32m", "\033[0m") if color else ("",) * 4
marks = {}
for line in tags.splitlines():
    n, cid, up = line.split()
    marks.setdefault(cid, []).append((n, up == "1"))

def describe(path):
    """(title, working directory), or None if it has no prompts"""
    custom = ai = last = first = cwd = None
    folder = os.path.basename(os.path.dirname(path))
    with open(path, encoding="utf-8", errors="replace") as f:
        for line in f:
            # the cwd Claude filed the conversation under (it can cd later)
            if cwd is None and '"cwd"' in line:
                for m in re.finditer(r'"cwd": ?"((?:[^"\\]|\\.)*)"', line):
                    try:
                        c = json.loads('"' + m.group(1) + '"')
                    except ValueError:
                        continue
                    if re.sub(r"[^A-Za-z0-9]", "-", c) == folder:
                        cwd = c
                        break
            # most lines are tool output: only parse the few that can matter
            if '"custom-title"' in line or '"ai-title"' in line or '"last-prompt"' in line:
                try:
                    d = json.loads(line)
                except ValueError:
                    continue
                t = d.get("type")
                if t == "custom-title":
                    custom = d.get("customTitle") or custom
                elif t == "ai-title":
                    ai = d.get("aiTitle") or ai
                elif t == "last-prompt":
                    last = d.get("lastPrompt") or last
            elif first is None and '"user"' in line:
                try:
                    d = json.loads(line)
                except ValueError:
                    continue
                if d.get("type") != "user":
                    continue
                c = (d.get("message") or {}).get("content")
                if isinstance(c, list):
                    c = " ".join(x.get("text", "") for x in c if isinstance(x, dict) and x.get("type") == "text")
                if isinstance(c, str) and c.strip() and not c.lstrip().startswith("<"):
                    first = c
    t = custom or ai or last or first
    return (" ".join(t.split()), cwd) if t else None

def project(path, cwd):
    """the working directory, ~-relative; else Claude's dashed folder name"""
    if cwd:
        if cwd == home:
            return "~"
        return cwd[len(home) + 1:] if cwd.startswith(home + "/") else cwd
    return os.path.basename(os.path.dirname(path)).lstrip("-")

def ago(t):
    s = time.time() - t
    for unit, n in (("d", 86400), ("h", 3600), ("m", 60)):
        if s >= n:
            return f"{int(s // n)}{unit}"
    return "now"

files = [f for f in glob.glob(os.path.join(glob.escape(root), "*", "*.jsonl"))
         if "observer-sessions" not in f]   # claude-mem's background sessions
files.sort(key=os.path.getmtime, reverse=True)
rows, more = [], False
for i, f in enumerate(files):
    d = describe(f)
    if d is None:
        continue
    rows.append((os.path.basename(f)[:-6], ago(os.path.getmtime(f)), project(f, d[1]), d[0]))
    if count and len(rows) >= count:
        more = i + 1 < len(files)
        break
if not rows:
    print("no Claude conversations found in " + root)
    sys.exit(0)

width = shutil.get_terminal_size((120, 24)).columns
pw = min(18, max(len(r[2]) for r in rows))
for cid, age, proj, title in rows:
    tag = ""
    for n, up in marks.get(cid, []):
        tag += f"[{n}{' ●' if up else ''}] "
    proj = proj if len(proj) <= pw else proj[:pw - 1] + "…"
    room = width - (36 + 2 + 4 + 2 + pw + 2) - len(tag) - 1
    if room > 8 and len(title) > room:
        title = title[:room - 1] + "…"
    c = ok if tag else ""
    print(f"{c}{cid}{off}  {dim}{age:>4}  {proj:<{pw}}{off}  {acc}{tag}{off}{title}")
if more:
    print(f"{dim}newest {len(rows)} shown; -n 0 lists all{off}")
PY
fi

if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
  c_acc=$(printf '\033[36m') c_dim=$(printf '\033[2m') c_off=$(printf '\033[0m')
else
  c_acc='' c_dim='' c_off=''
fi
step() { printf '%s▸%s %s\n' "$c_acc" "$c_off" "$*"; }
info() { printf '  %s%s%s\n' "$c_dim" "$*" "$c_off"; }

command -v dtach >/dev/null 2>&1 || {
  echo "tether: dtach is not installed on $(hostname) (apt/dnf/brew install dtach)" >&2
  exit 1
}

# the Claude process under the master, and the conversation it is in
# (Claude keeps $cfg/sessions/<pid>.json up to date with its sessionId)
session_of() {
  for p in $(pgrep -P "$1") $(for c in $(pgrep -P "$1"); do pgrep -P "$c"; done); do
    f=$cfg/sessions/$p.json
    [ -f "$f" ] || continue
    sed -n 's/.*"sessionId": *"\([^"]*\)".*/\1/p' "$f"
    return
  done
}

# age, prompt count and last prompt of the conversation a new session resumes
summary() {
  proj=$cfg/projects/$(cd "$1" && pwd -P | sed 's/[^A-Za-z0-9]/-/g')   # physical path, like Claude
  id=$(cat "$state" 2>/dev/null)
  f=$proj/$id.jsonl
  if [ -z "$id" ] || [ ! -f "$f" ]; then info "new conversation"; return; fi
  info "resuming the conversation this session was last in"
  command -v python3 >/dev/null 2>&1 || return 0   # details are optional
  python3 - "$f" "$c_dim" "$c_off" <<'PY' 2>/dev/null
import json, os, sys, time
path, dim, off = sys.argv[1:4]
last, n = None, 0
for line in open(path, encoding="utf-8", errors="replace"):
    try:
        d = json.loads(line)
    except ValueError:
        continue
    if d.get("type") != "user":
        continue
    c = (d.get("message") or {}).get("content")
    if isinstance(c, list):
        c = " ".join(x.get("text", "") for x in c if isinstance(x, dict) and x.get("type") == "text")
    if isinstance(c, str) and c.strip() and not c.lstrip().startswith("<"):
        last, n = " ".join(c.split()), n + 1
mins = int(time.time() - os.path.getmtime(path)) // 60
ago = f"{mins} min ago" if mins < 120 else f"{mins // 60} h ago"
print(f"  {dim}last active {ago}, {n} prompt{'s' if n != 1 else ''}{off}")
if last:
    short = last if len(last) <= 70 else last[:70] + "…"
    print(f'  {dim}last prompt: "{short}"{off}')
PY
}

master=$(find_master)
if [ -n "$master" ] && [ -S "$sock" ]; then
  sid=$(session_of "$master")
  [ -n "$sid" ] && printf %s "$sid" >"$state"   # a restart resumes exactly this one
  since=$(ps -o lstart= -p "$master" 2>/dev/null | awk '{print $4}')
  step "Reattaching to Claude session '$name' ${c_dim}(up since ${since:-?})$c_off"
  others=$(($(pgrep -f "^dtach -A $sock " | wc -l) - 1))   # minus the master
  [ "$others" -gt 0 ] && info "also attached in $others other window(s)"
  [ -n "$dir" ] && info "-d ignored: the session is already running in $(cat "$dirfile" 2>/dev/null)"
  if [ "${TETHER_RESTORE_MODES:-1}" = 1 ] && [ -t 1 ]; then
    # Claude enables these only at startup; this terminal may be new, or may
    # have been reset after a dropped link: focus events, color-scheme
    # reports, kitty keyboard flags 5, modifyOtherKeys 2. Terminals that
    # don't support one ignore it.
    printf '\033[?1004h\033[?2031h\033[>5u\033[>4;2m'
  fi
else
  rm -f "$sock"
  [ -z "$dir" ] && [ -f "$dirfile" ] && dir=$(cat "$dirfile")
  dir=${dir:-${TETHER_DIR:-$HOME}}
  # shellcheck disable=SC2088  # matching a literal "~" sent by the client
  case $dir in "~") dir=$HOME ;; "~/"*) dir=$HOME/${dir#"~/"} ;; /*) ;; *) dir=$HOME/$dir ;; esac
  [ -d "$dir" ] || { echo "tether: no such directory on $(hostname): $dir" >&2; exit 1; }
  printf %s "$dir" >"$dirfile"
  step "Starting Claude session '$name' in ${dir#"$HOME"/}"
  summary "$dir"
  info "loading…"
fi
info "detach: Ctrl-\\"

# -r ctrl_l: redraw with Ctrl-L. The default (winch) sends a resize, which
# Claude ignores when the size is unchanged, leaving a blank screen.
# A login shell gives tether-run the user's normal PATH.
# shellcheck disable=SC2016  # $0 and $@ expand in the inner shell
dtach -A "$sock" -z -r ctrl_l "${SHELL:-/bin/sh}" -lc 'exec "$0" "$@"' "$run" "$(cat "$dirfile")" "$state"

sleep 0.3   # let the master finish exiting if Claude quit
printf '\r\033[K'
if [ -n "$(find_master)" ]; then
  step "Detached. Claude keeps running ${c_dim}(run again to reattach)$c_off"
else
  step "Claude exited. ${c_dim}Next time it resumes this conversation.$c_off"
fi
